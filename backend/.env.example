PORT=4000
RPC_URL=http://127.0.0.1:8545
WORKFLOW_ADDRESS=0x0000000000000000000000000000000000000000
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
IPFS_API_URL=http://127.0.0.1:5001
ALLOWED_ORIGIN=http://localhost:5173
# Indeksimi i eventeve: per Sepolia vendos startBlock nga deployments/sepolia.json
INDEXER_START_BLOCK=0
# Madhesia e intervalit per eth_getLogs (disa RPC falas lejojne interval te vogel, p.sh. 10)
INDEXER_BLOCK_RANGE=2000
INDEXER_POLL_MS=4000
# Versioni 3 - "Syri i tretë"
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_AUTO_ASSESS=true
# Celesi i oracle-it qe nenshkruan vleresimet (lokalisht Hardhat Account #6; ne Sepolia nje wallet testues i vecante)
ORACLE_PRIVATE_KEY=
# Gateway per te lexuar fotot nga IPFS (kur nuk perdoret fallback-u lokal)
IPFS_GATEWAY_URL=http://127.0.0.1:8080
